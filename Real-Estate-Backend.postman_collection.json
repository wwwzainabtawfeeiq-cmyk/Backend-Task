{
  "info": {
    "_postman_id": "real-estate-backend-api",
    "name": "Real Estate Platform Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"New User\",\"email\":\"newuser@test.com\",\"password\":\"password123\",\"role\":\"client\"}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@test.com\",\"password\":\"admin123\"}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization","value":"Bearer {{token}}"}],
            "url": "{{base_url}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "List Properties",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/properties"
          }
        },
        {
          "name": "Property Details",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/properties/1"
          }
        },
        {
          "name": "Create Property",
          "request": {
            "method": "POST",
            "header": [
              {"key":"Authorization","value":"Bearer {{token}}"},
              {"key":"Content-Type","value":"application/json"}
            ],
            "body": {
              "mode":"raw",
              "raw":"{\"title\":\"Modern Property\",\"description\":\"Beautiful property\",\"price\":150000,\"city\":\"Basra\",\"address\":\"Basra\",\"category_id\":1}"
            },
            "url": "{{base_url}}/api/properties"
          }
        },
        {
          "name": "Update Property",
          "request": {
            "method":"PUT",
            "header":[
              {"key":"Authorization","value":"Bearer {{token}}"},
              {"key":"Content-Type","value":"application/json"}
            ],
            "body":{"mode":"raw","raw":"{\"title\":\"Updated Property\",\"price\":160000}"},
            "url":"{{base_url}}/api/properties/1"
          }
        },
        {
          "name":"Delete Property",
          "request":{
            "method":"DELETE",
            "header":[{"key":"Authorization","value":"Bearer {{token}}"}],
            "url":"{{base_url}}/api/properties/1"
          }
        }
      ]
    },
    {
      "name":"Categories",
      "item":[
        {
          "name":"List Categories",
          "request":{"method":"GET","url":"{{base_url}}/api/categories"}
        },
        {
          "name":"Create Category",
          "request":{
            "method":"POST",
            "header":[
              {"key":"Authorization","value":"Bearer {{token}}"},
              {"key":"Content-Type","value":"application/json"}
            ],
            "body":{"mode":"raw","raw":"{\"name\":\"Apartment\"}"},
            "url":"{{base_url}}/api/categories"
          }
        }
      ]
    },
    {
      "name":"Favorites",
      "item":[
        {
          "name":"Add Favorite",
          "request":{
            "method":"POST",
            "header":[{"key":"Authorization","value":"Bearer {{token}}"}],
            "url":"{{base_url}}/api/properties/1/favorite"
          }
        },
        {
          "name":"My Favorites",
          "request":{
            "method":"GET",
            "header":[{"key":"Authorization","value":"Bearer {{token}}"}],
            "url":"{{base_url}}/api/favorites"
          }
        }
      ]
    },
    {
      "name":"Inquiries",
      "item":[
        {
          "name":"Create Inquiry",
          "request":{
            "method":"POST",
            "header":[
              {"key":"Authorization","value":"Bearer {{token}}"},
              {"key":"Content-Type","value":"application/json"}
            ],
            "body":{"mode":"raw","raw":"{\"message\":\"I am interested in this property\"}"},
            "url":"{{base_url}}/api/properties/1/inquire"
          }
        },
        {
          "name":"Agent Inquiries",
          "request":{
            "method":"GET",
            "header":[{"key":"Authorization","value":"Bearer {{token}}"}],
            "url":"{{base_url}}/api/agent/inquiries"
          }
        },
        {
          "name":"Update Inquiry Status",
          "request":{
            "method":"PATCH",
            "header":[
              {"key":"Authorization","value":"Bearer {{token}}"},
              {"key":"Content-Type","value":"application/json"}
            ],
            "body":{"mode":"raw","raw":"{\"status\":\"replied\"}"},
            "url":"{{base_url}}/api/inquiries/1/status"
          }
        }
      ]
    },
    {
      "name":"Admin",
      "item":[
        {
          "name":"List Users",
          "request":{
            "method":"GET",
            "header":[{"key":"Authorization","value":"Bearer {{token}}"}],
            "url":"{{base_url}}/api/admin/users"
          }
        },
        {
          "name":"Change User Role",
          "request":{
            "method":"PATCH",
            "header":[
              {"key":"Authorization","value":"Bearer {{token}}"},
              {"key":"Content-Type","value":"application/json"}
            ],
            "body":{"mode":"raw","raw":"{\"role\":\"agent\"}"},
            "url":"{{base_url}}/api/admin/users/3/role"
          }
        }
      ]
    },
    {
      "name":"Analytics",
      "item":[
        {
          "name":"Agent Analytics",
          "request":{
            "method":"GET",
            "header":[{"key":"Authorization","value":"Bearer {{token}}"}],
            "url":"{{base_url}}/api/agent/analytics"
          }
        }
      ]
    }
  ]
}
